[Unit]
Description=Folkrace Dual-Core Autonomous Racing System & Debug Studio
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/folkrace
ExecStart=/usr/bin/python3 -u /home/admin/folkrace/run_folkrace_system.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

